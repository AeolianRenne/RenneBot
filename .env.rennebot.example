# Docker build/runtime settings. Do not commit the copied .env.rennebot file.
TZ=Asia/Shanghai
RUNTIME_DIR=/opt/rennebot/runtime

# Optional independently deployed Global BanPick service.
# Set a public HTTPS origin before sharing match links with players.
BANPICK_PUBLIC_BASE_URL=https://bp.example.com
BANPICK_BOT_API_KEY=replace-with-a-long-random-secret
BANPICK_ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password
# Leave this as the Compose service name for the bundled deployment.
BANPICK_INTERNAL_URL=http://banpick:8000

# Optional build-time override for a Docker registry proxy. Leave commented when
# Docker Hub is reachable directly.
# PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
# BANPICK_NODE_BASE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
# BANPICK_PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
# BANPICK_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# The custom plugin sends requests only for authorized QQ private chats/groups.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30

# Persistent private AI context. Older turns are summarized when this character
# budget is exceeded; no context is retained for group /ai requests.
AI_PRIVATE_CONTEXT_MAX_CHARS=120000
AI_PRIVATE_CONTEXT_RECENT_MESSAGES=24
# The maximum length accepted for one private AI message. Oversized messages are
# neither sent to the model nor persisted in SQLite.
AI_PRIVATE_MESSAGE_MAX_CHARS=8000

# Explicit private research tasks use Tavily for public-web search. Leave the key
# unset to keep research tasks unavailable without making any outbound request.
TAVILY_API_KEY=
AI_RESEARCH_TIMEOUT_SECONDS=20
# Total evidence sources injected into one answer. Use at least six when a task
# compares several named providers.
AI_RESEARCH_MAX_SOURCES=6
# Focused searches for named providers plus one broad task search.
AI_RESEARCH_MAX_QUERIES=6
# Set to 1 for a single search round, or 2 for one evidence-driven follow-up.
# This does not raise the total query or logical-operation budgets above.
AI_RESEARCH_MAX_ROUNDS=2
# Total logical public-web operations in one task turn. One Tavily query and one
# public-page extraction each count as one; 12 allows six of each.
AI_RESEARCH_MAX_REQUESTS=12
# Search cache is isolated per QQ user and expires after this many seconds.
AI_RESEARCH_CACHE_TTL_SECONDS=900
# Whole-task budget covering search, public-page extraction, and the final model call.
AI_RESEARCH_TASK_TIMEOUT_SECONDS=90
# For each Tavily result, the task may read public HTML text without cookies or
# credentials. Non-HTML pages, login walls, and oversized responses fall back to
# the Tavily search summary instead of attempting access controls.
AI_RESEARCH_EXTRACT_TIMEOUT_SECONDS=12
AI_RESEARCH_EXTRACT_MAX_BYTES=1048576
AI_RESEARCH_EXTRACT_MAX_CHARS=6000
