# Docker build/runtime settings. Do not commit the copied .env.rennebot file.
TZ=Asia/Shanghai
RUNTIME_DIR=/opt/rennebot/runtime

# Optional build-time override for a Docker registry proxy. Leave commented when
# Docker Hub is reachable directly.
# PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim

# The custom plugin sends requests only for authorized QQ private chats/groups.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
